{
  "info": {"name":"FieldForceConnect - QA Machine Test","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key":"base_url","value":"https://test.fieldforceconnect.com"},
    {"key":"email","value":"YOUR_SIGNUP_EMAIL"},
    {"key":"password","value":"YOUR_PASSWORD"},
    {"key":"token","value":""},
    {"key":"add_customer_endpoint","value":"REPLACE_WITH_ADD_CUSTOMER_ENDPOINT"}
  ],
  "item": [
    {"name":"Login - Valid Credentials","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},"url":{"raw":"{{base_url}}/api/account/authenticate"}},"event":[{"listen":"test","script":{"exec":["const jsonData = pm.response.json();","pm.test('HTTP response received',()=>pm.expect(pm.response.code).to.eql(200));","pm.test('Login success flag is true',()=>pm.expect(jsonData.success).to.eql(true));","pm.test('Referral token is present',()=>pm.expect(jsonData.referralToken).to.be.a('string').and.not.empty);","pm.environment.set('token',jsonData.referralToken);"]}}]},
    {"name":"Login - Invalid Credentials","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"invalid@example.com\",\n  \"password\": \"WrongPassword@123\"\n}"},"url":{"raw":"{{base_url}}/api/account/authenticate"}},"event":[{"listen":"test","script":{"exec":["const jsonData = pm.response.json();","pm.test('Success flag is false',()=>pm.expect(jsonData.success).to.eql(false));","pm.test('Invalid credential message',()=>pm.expect(jsonData.errormessage).to.eql('Invalid Email Id / Mobile No or Password.'));"]}}]},
    {"name":"Add Customer - POST","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Test Customer\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"testcustomer@example.com\",\n  \"address\": \"Mumbai\"\n}"},"url":{"raw":"{{add_customer_endpoint}}"}}}
  ]
}
